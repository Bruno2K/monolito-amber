// Amber Modular Monolith — schema-per-module (0.6).
// PF-1.6: Governance owns Gate / GateRequirement / FormalException / release evidence.
// M5.1: Calendar + Messaging schemas (additive). No ResourceAllocation/TimeEntry.
// Seed permissions from the closed catalog (0.2A + M3.1 Operations + M5.1 reserved codes).
// There is no gate.override.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "org", "project", "document", "coordination", "planning", "governance", "operations", "calendar", "messaging", "audit", "jobs"]
}

// ---------------------------------------------------------------------------
// identity
// ---------------------------------------------------------------------------

/// Global business identity. Not an authentication method.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  displayName   String    @map("display_name")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  authenticationIdentities AuthenticationIdentity[]
  sessions                 Session[]
  memberships              OrganizationMembership[]
  invitationsSent          Invitation[]             @relation("InvitationInviter")
  invitationsAccepted      Invitation[]             @relation("InvitationAcceptedBy")
  passwordResetTokens      PasswordResetToken[]
  mfaTotp                  MfaTotpCredential?
  mfaRecoveryCodes         MfaRecoveryCode[]
  mfaChallenges            MfaChallenge[]

  @@map("users")
  @@schema("identity")
}

/// Provider-specific authentication identity (EMAIL_PASSWORD now; Entra/Google/SSO_ONLY later).
model AuthenticationIdentity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  identifier String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id])
  passwordCredential PasswordCredential?
  sessions           Session[]

  @@unique([provider, identifier])
  @@index([userId])
  @@map("authentication_identities")
  @@schema("identity")
}

/// Argon2id required (0.2A). bcrypt only as documented fallback.
model PasswordCredential {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authenticationIdentityId String    @unique @map("authentication_identity_id") @db.Uuid
  algorithm                String
  hash                     String
  parameters               Json
  failedAttempts           Int       @default(0) @map("failed_attempts")
  lockedUntil              DateTime? @map("locked_until")
  passwordChangedAt        DateTime  @default(now()) @map("password_changed_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  authenticationIdentity AuthenticationIdentity @relation(fields: [authenticationIdentityId], references: [id])

  @@map("password_credentials")
  @@schema("identity")
}

/// Opaque session. Cookie holds random token; server stores hash only (0.2A).
/// Active organization is session-bound — never trust client orgId (F-04).
model Session {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  authenticationIdentityId String?   @map("authentication_identity_id") @db.Uuid
  tokenHash                String    @unique @map("token_hash")
  activeOrganizationId     String?   @map("active_organization_id") @db.Uuid
  ipAddress                String?   @map("ip_address")
  userAgent                String?   @map("user_agent")
  lastReauthAt             DateTime? @map("last_reauth_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  lastSeenAt               DateTime  @default(now()) @map("last_seen_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  revokeReason             String?   @map("revoke_reason")

  user                   User                    @relation(fields: [userId], references: [id])
  authenticationIdentity AuthenticationIdentity? @relation(fields: [authenticationIdentityId], references: [id])

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("sessions")
  @@schema("identity")
}

/// Invitation tokens stored hashed only; default expiry 7 days (0.2A).
model Invitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  email           String
  tokenHash       String    @unique @map("token_hash")
  invitedById     String    @map("invited_by_id") @db.Uuid
  acceptedById    String?   @map("accepted_by_id") @db.Uuid
  roleTemplateKey String?   @map("role_template_key")
  membershipType  String    @default("INTERNAL") @map("membership_type")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizationId, email])
  @@map("invitations")
  @@schema("identity")
}

/// Reset tokens hashed; default expiry 30 minutes; success revokes all sessions (0.2A).
model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("identity")
}

/// TOTP MFA required for Org Admin + Governance Approver (0.2A).
/// Secret is stored encrypted (must be recoverable to verify). Hash is integrity-only.
model MfaTotpCredential {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  secretHash      String    @map("secret_hash")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("mfa_totp_credentials")
  @@schema("identity")
}

/// Recovery codes generated once, stored hashed, regenerated only after re-auth (0.2A §9).
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  batchId   String    @map("batch_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, batchId])
  @@map("mfa_recovery_codes")
  @@schema("identity")
}

/// Short-lived hashed MFA / re-auth challenge tokens.
model MfaChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  purpose    String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("mfa_challenges")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// org
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   OrganizationMembership[]
  roles         RoleDefinition[]
  projects      Project[]
  invitations   Invitation[]
  disciplines   Discipline[]
  teams         Team[]
  calendars     Calendar[]
  conversations Conversation[]

  @@map("organizations")
  @@schema("org")
}

model OrganizationMembership {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  status         String
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deactivatedAt  DateTime? @map("deactivated_at")

  organization            Organization           @relation(fields: [organizationId], references: [id])
  user                    User                   @relation(fields: [userId], references: [id])
  roleBindings            RoleBinding[]
  projectMemberships      ProjectMembership[]
  teamMemberships         TeamMembership[]
  ownedCalendars          Calendar[]
  calendarGrantSubjects   CalendarAccessGrant[]  @relation("CalendarGrantSubject")
  calendarGrantsCreated   CalendarAccessGrant[]  @relation("CalendarGrantCreator")
  calendarEventsCreated   CalendarEvent[]
  directConversationsLow  Conversation[]         @relation("DirectParticipantLow")
  directConversationsHigh Conversation[]         @relation("DirectParticipantHigh")
  messagesAuthored        Message[]
  messageReadStates       MessageReadState[]

  @@unique([organizationId, userId])
  @@map("organization_memberships")
  @@schema("org")
}

/// Closed 0.2A permission catalog. No invented codes. No gate.override.
model PermissionDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  module      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permission_definitions")
  @@schema("org")
}

/// Amber Role Template when organizationId is null / isSystemTemplate=true.
/// Organization-owned RoleDefinition when organizationId is set — the only
/// operational AuthZ grant target. Lineage: sourceTemplateKey / templateKey.
model RoleDefinition {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String?  @map("organization_id") @db.Uuid
  templateKey       String   @map("template_key")
  sourceTemplateKey String   @map("source_template_key")
  name              String
  description       String
  isSystemTemplate  Boolean  @default(true) @map("is_system_template")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization       Organization?           @relation(fields: [organizationId], references: [id])
  rolePermissions    RolePermission[]
  bindings           RoleBinding[]
  projectAssignments ProjectRoleAssignment[]

  @@unique([organizationId, templateKey])
  @@map("role_definitions")
  @@schema("org")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       RoleDefinition       @relation(fields: [roleId], references: [id])
  permission PermissionDefinition @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("org")
}

/// Organization-level role binding. Never implies Project access.
/// Must reference an Organization-owned RoleDefinition (not a global template).
model RoleBinding {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership OrganizationMembership @relation(fields: [membershipId], references: [id])
  role       RoleDefinition         @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId])
  @@map("role_bindings")
  @@schema("org")
}

/// Organization-owned Discipline catalog. Not Project access. Not an assignee.
/// Historical Document/Issue/Task identifier strings are preserved separately.
model Discipline {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String
  name           String
  active         Boolean  @default(true)
  sortOrder      Int?     @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  deliverables Deliverable[]
  workPackages WorkPackage[]

  @@index([organizationId])
  @@map("disciplines")
  @@schema("org")
}

/// Organization-owned Team. TeamMembership ≠ ProjectMembership.
model Team {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id])
  memberships      TeamMembership[]
  deliverables     Deliverable[]
  workPackages     WorkPackage[]
  calendarGrants   CalendarAccessGrant[]
  teamConversation Conversation?

  @@index([organizationId])
  @@map("teams")
  @@schema("org")
}

model TeamMembership {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId                   String   @map("team_id") @db.Uuid
  organizationMembershipId String   @map("organization_membership_id") @db.Uuid
  status                   String
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  team                   Team                   @relation(fields: [teamId], references: [id])
  organizationMembership OrganizationMembership @relation(fields: [organizationMembershipId], references: [id])

  @@unique([teamId, organizationMembershipId])
  @@index([organizationMembershipId])
  @@map("team_memberships")
  @@schema("org")
}

// ---------------------------------------------------------------------------
// project — membership + contextual RBAC (no product Document/Gate UX)
// ---------------------------------------------------------------------------

model Project {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id])
  memberships  ProjectMembership[]
  objects      StoredObject[]
  documents    Document[]
  impactAnalyses ImpactAnalysis[]
  issues         Issue[]
  tasks          Task[]
  milestones     Milestone[]
  gates          Gate[]
  gateRequirements GateRequirement[]
  formalExceptions FormalException[]
  gateReleaseDecisions GateReleaseDecision[]
  gateReleaseUsedExceptions GateReleaseUsedException[]
  phases         Phase[]
  deliverables   Deliverable[]
  workPackages   WorkPackage[]
  deliverableDocuments DeliverableDocument[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("projects")
  @@schema("project")
}

/// First-class ProjectMembership. ACTIVE OrgMembership is required to become
/// ACTIVE here; Org suspension/removal overrides all Project access.
model ProjectMembership {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                String    @map("project_id") @db.Uuid
  organizationMembershipId String    @map("organization_membership_id") @db.Uuid
  status                   String
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deactivatedAt            DateTime? @map("deactivated_at")

  project                Project                @relation(fields: [projectId], references: [id])
  organizationMembership OrganizationMembership @relation(fields: [organizationMembershipId], references: [id])
  roleAssignments        ProjectRoleAssignment[]
  ownedDeliverables      Deliverable[]
  ownedWorkPackages      WorkPackage[]

  @@unique([projectId, organizationMembershipId])
  @@index([organizationMembershipId])
  @@map("project_memberships")
  @@schema("project")
}

/// Per-project role assignment. References Organization-owned RoleDefinitions
/// of the same Organization only. Effective permissions = union in that Project.
model ProjectRoleAssignment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectMembershipId String   @map("project_membership_id") @db.Uuid
  roleId              String   @map("role_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  projectMembership ProjectMembership @relation(fields: [projectMembershipId], references: [id])
  role              RoleDefinition    @relation(fields: [roleId], references: [id])

  @@unique([projectMembershipId, roleId])
  @@map("project_role_assignments")
  @@schema("project")
}

// ---------------------------------------------------------------------------
// operations — Phase (M3.3), Deliverable (M3.4), WorkPackage (M3.5 additive).
// Does not move Project / Task / Document / Issue / Gate ownership.
// ---------------------------------------------------------------------------

/// Project-scoped delivery phase. Dates do not transit status. Overlap allowed.
/// Sequence is unique among non-archived Phases of the same Project (SQL partial unique).
model Phase {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  name           String
  description    String    @default("")
  sequence       Int
  plannedStartAt DateTime? @map("planned_start_at")
  plannedEndAt   DateTime? @map("planned_end_at")
  actualStartAt  DateTime? @map("actual_start_at")
  actualEndAt    DateTime? @map("actual_end_at")
  status         String
  createdBy      String    @map("created_by") @db.Uuid
  version        Int       @default(1)
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id])
  deliverables Deliverable[]
  workPackages WorkPackage[]
  tasks        Task[]
  milestones   Milestone[]

  @@index([organizationId, projectId])
  @@index([projectId, sequence])
  @@map("phases")
  @@schema("operations")
}

/// Business/technical outcome — not a Document, Task, Milestone, or card.
/// phaseId and disciplineId are required. Ownership is XOR (user | Team | none).
/// Code is unique case-insensitive among non-archived rows of the Project (SQL partial unique).
model Deliverable {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  projectId                String    @map("project_id") @db.Uuid
  phaseId                  String    @map("phase_id") @db.Uuid
  disciplineId             String    @map("discipline_id") @db.Uuid
  code                     String
  title                    String
  description              String    @default("")
  ownerProjectMembershipId String?   @map("owner_project_membership_id") @db.Uuid
  ownerTeamId              String?   @map("owner_team_id") @db.Uuid
  plannedStartAt           DateTime? @map("planned_start_at")
  dueAt                    DateTime? @map("due_at")
  status                   String
  progressPercent          Int?      @map("progress_percent")
  version                  Int       @default(1)
  archivedAt               DateTime? @map("archived_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  project                Project             @relation(fields: [projectId], references: [id])
  phase                  Phase               @relation(fields: [phaseId], references: [id])
  discipline             Discipline          @relation(fields: [disciplineId], references: [id])
  ownerProjectMembership ProjectMembership?  @relation(fields: [ownerProjectMembershipId], references: [id])
  ownerTeam              Team?               @relation(fields: [ownerTeamId], references: [id])
  workPackages           WorkPackage[]
  tasks                  Task[]
  milestones             Milestone[]
  documentLinks          DeliverableDocument[]

  @@index([organizationId, projectId])
  @@index([phaseId])
  @@index([disciplineId])
  @@index([ownerProjectMembershipId])
  @@index([ownerTeamId])
  @@map("deliverables")
  @@schema("operations")
}

/// Operational breakdown unit. Additive schema from M3.4 (delivery rule);
/// M3.5 exposes WorkPackage CRUD, lifecycle, and Deliverable association.
/// WorkPackage ≠ Task. Archive is the removal path (never hard-delete).
model WorkPackage {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  projectId                String    @map("project_id") @db.Uuid
  phaseId                  String    @map("phase_id") @db.Uuid
  deliverableId            String?   @map("deliverable_id") @db.Uuid
  disciplineId             String?   @map("discipline_id") @db.Uuid
  code                     String?
  title                    String
  description              String    @default("")
  blockedReason            String?   @map("blocked_reason")
  ownerProjectMembershipId String?   @map("owner_project_membership_id") @db.Uuid
  ownerTeamId              String?   @map("owner_team_id") @db.Uuid
  plannedStartAt           DateTime? @map("planned_start_at")
  dueAt                    DateTime? @map("due_at")
  status                   String
  version                  Int       @default(1)
  archivedAt               DateTime? @map("archived_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  project                Project             @relation(fields: [projectId], references: [id])
  phase                  Phase               @relation(fields: [phaseId], references: [id])
  deliverable            Deliverable?        @relation(fields: [deliverableId], references: [id])
  discipline             Discipline?         @relation(fields: [disciplineId], references: [id])
  ownerProjectMembership ProjectMembership?  @relation(fields: [ownerProjectMembershipId], references: [id])
  ownerTeam              Team?               @relation(fields: [ownerTeamId], references: [id])
  tasks                  Task[]

  @@index([organizationId, projectId])
  @@index([phaseId])
  @@index([deliverableId])
  @@index([disciplineId])
  @@index([ownerProjectMembershipId])
  @@index([ownerTeamId])
  @@map("work_packages")
  @@schema("operations")
}

/// M3.7 additive Document↔Deliverable evidence join. Context only — does not
/// change Document/Revision identity, status, or published bytes.
model DeliverableDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  deliverableId   String   @map("deliverable_id") @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  project     Project     @relation(fields: [projectId], references: [id])
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  document    Document    @relation(fields: [documentId], references: [id])

  @@unique([deliverableId, documentId])
  @@index([organizationId, projectId])
  @@index([documentId])
  @@map("deliverable_documents")
  @@schema("operations")
}

// ---------------------------------------------------------------------------
// document — Document + Revision lifecycle + file-trust (PF-1.3)
// ---------------------------------------------------------------------------

enum ScanStatus {
  PENDING
  CLEAN
  BLOCKED

  @@schema("document")
}

/// Stable logical artifact. Identity is not a filename or storage key.
/// Archive is soft. Currentness is currentRevisionId (at most one).
model Document {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  /// Catalog-pending identifier from 0.3; not a Discipline FK in this slice.
  disciplineId      String?   @map("discipline_id")
  documentType      String?   @map("document_type")
  code              String
  title             String
  status            String    @default("ACTIVE")
  currentRevisionId String?   @unique @map("current_revision_id") @db.Uuid
  version           Int       @default(1)
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  project         Project    @relation(fields: [projectId], references: [id])
  currentRevision Revision?  @relation("DocumentCurrentRevision", fields: [currentRevisionId], references: [id])
  revisions       Revision[] @relation("DocumentRevisions")
  objects         StoredObject[]
  deliverableLinks DeliverableDocument[]

  @@unique([projectId, code])
  @@index([organizationId, projectId])
  @@map("documents")
  @@schema("document")
}

/// One version of a Document. DRAFT is mutable; immutability starts at PUBLISHED.
/// REJECTED is preserved. APPROVED stays APPROVED when no longer current.
model Revision {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  documentId              String    @map("document_id") @db.Uuid
  revisionCode            String    @map("revision_code")
  storedObjectId          String?   @unique @map("stored_object_id") @db.Uuid
  fileName                String?   @map("file_name")
  publishedChecksumSha256 String?   @map("published_checksum_sha256")
  status                  String    @default("DRAFT")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  publishedByUserId       String?   @map("published_by_user_id") @db.Uuid
  publishedAt             DateTime? @map("published_at")
  reviewedByUserId        String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt              DateTime? @map("reviewed_at")
  approvedByUserId        String?   @map("approved_by_user_id") @db.Uuid
  approvedAt              DateTime? @map("approved_at")
  rejectedByUserId        String?   @map("rejected_by_user_id") @db.Uuid
  rejectedAt              DateTime? @map("rejected_at")
  rejectionReason         String?   @map("rejection_reason")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  document       Document      @relation("DocumentRevisions", fields: [documentId], references: [id])
  storedObject   StoredObject? @relation("RevisionStoredObject", fields: [storedObjectId], references: [id])
  currentFor     Document?     @relation("DocumentCurrentRevision")

  @@unique([documentId, revisionCode])
  @@index([organizationId, projectId])
  @@index([documentId, status])
  @@map("revisions")
  @@schema("document")
}

/// Object metadata + scan_status. Download/preview fail-closed unless CLEAN (F-08).
/// Vendor for scanning remains OPEN (implementation choice).
model StoredObject {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  documentId     String?    @map("document_id") @db.Uuid
  storageKey     String     @unique @map("storage_key")
  checksumSha256 String     @map("checksum_sha256")
  mimeType       String     @map("mime_type")
  byteSize       Int        @map("byte_size")
  originalFileName String?  @map("original_file_name")
  /// Fail-closed: PENDING / scan failure = deny; CLEAN = authorized access; BLOCKED = deny + security event.
  scanStatus     ScanStatus @default(PENDING) @map("scan_status")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])
  revision Revision? @relation("RevisionStoredObject")

  @@index([organizationId, projectId])
  @@index([checksumSha256])
  @@map("stored_objects")
  @@schema("document")
}

// ---------------------------------------------------------------------------
// coordination — Impact Analysis + Issue foundation (PF-1.4 / 0.4)
// Tasks live in planning. Completing a Task does not mutate Issue status.
// ---------------------------------------------------------------------------

/// One case per CurrentRevisionChanged / NewBaseEstablished change event.
/// Auto-created as PENDING_ANALYSIS only. Assessment is always explicit.
model ImpactAnalysis {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  documentId            String    @map("document_id") @db.Uuid
  sourceRevisionId      String    @map("source_revision_id") @db.Uuid
  previousRevisionId    String?   @map("previous_revision_id") @db.Uuid
  /// Stable at-most-one key for the companion outbox pair.
  changeKey             String    @unique @map("change_key")
  sourceOutboxMessageId String?   @map("source_outbox_message_id") @db.Uuid
  correlationId         String    @map("correlation_id")
  status                String    @default("PENDING_ANALYSIS")
  affectedContext       String?   @map("affected_context")
  assessedByUserId      String?   @map("assessed_by_user_id") @db.Uuid
  assessedAt            DateTime? @map("assessed_at")
  assessmentResult      String?   @map("assessment_result")
  assessmentRationale   String?   @map("assessment_rationale")
  resolvedByUserId      String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt            DateTime? @map("resolved_at")
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id])
  issues  Issue[]

  @@index([organizationId, projectId])
  @@index([documentId, sourceRevisionId])
  @@map("impact_analyses")
  @@schema("coordination")
}

/// Coordination problem / pendência. Origin is server-derived (IMPACT | MANUAL).
model Issue {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  impactAnalysisId        String?   @map("impact_analysis_id") @db.Uuid
  origin                  String
  title                   String
  description             String    @default("")
  status                  String    @default("OPEN")
  /// Severity ≠ Priority. Neither is inferred from the other.
  severity                String?
  priority                String?
  /// Discipline ≠ assignee.
  responsibleDisciplineId String?   @map("responsible_discipline_id")
  assigneeUserId          String?   @map("assignee_user_id") @db.Uuid
  dueDate                 DateTime? @map("due_date")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  resolvedByUserId        String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt              DateTime? @map("resolved_at")
  closedByUserId          String?   @map("closed_by_user_id") @db.Uuid
  closedAt                DateTime? @map("closed_at")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  project        Project             @relation(fields: [projectId], references: [id])
  impactAnalysis ImpactAnalysis?     @relation(fields: [impactAnalysisId], references: [id])
  statusEvents   IssueStatusEvent[]
  comments       IssueComment[]
  evidence       IssueEvidence[]
  tasks          Task[]

  @@index([organizationId, projectId])
  @@index([impactAnalysisId])
  @@map("issues")
  @@schema("coordination")
}

/// Append-only Issue status history so reopen never loses prior transitions.
model IssueStatusEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  fromStatus     String   @map("from_status")
  toStatus       String   @map("to_status")
  actorUserId    String   @map("actor_user_id") @db.Uuid
  rationale      String?
  createdAt      DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id])

  @@index([issueId, createdAt])
  @@map("issue_status_events")
  @@schema("coordination")
}

model IssueComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id])

  @@index([issueId, createdAt])
  @@map("issue_comments")
  @@schema("coordination")
}

/// Minimal evidence reference. No collaboration UI. May point at a same-tenant StoredObject.
model IssueEvidence {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  issueId        String   @map("issue_id") @db.Uuid
  addedByUserId  String   @map("added_by_user_id") @db.Uuid
  kind           String
  storedObjectId String?  @map("stored_object_id") @db.Uuid
  reference      String?
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id])

  @@index([issueId, createdAt])
  @@map("issue_evidence")
  @@schema("coordination")
}

// ---------------------------------------------------------------------------
// planning — Task / TaskDependency / Milestone (PF-1.5 / 0.5)
// Issue ≠ Task. Completing a Task does not resolve an Issue or achieve a Milestone.
// Governance reads Planning via adapters; it does not mutate these tables.
// ---------------------------------------------------------------------------

/// Executable work. Optional source Issue and optional Milestone, same Project.
model Task {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  issueId                 String?   @map("issue_id") @db.Uuid
  milestoneId             String?   @map("milestone_id") @db.Uuid
  phaseId                 String?   @map("phase_id") @db.Uuid
  deliverableId           String?   @map("deliverable_id") @db.Uuid
  workPackageId           String?   @map("work_package_id") @db.Uuid
  title                   String
  description             String    @default("")
  status                  String    @default("TODO")
  priority                String?
  responsibleDisciplineId String?   @map("responsible_discipline_id")
  assigneeUserId          String?   @map("assignee_user_id") @db.Uuid
  dueDate                 DateTime? @map("due_date")
  plannedStartAt          DateTime? @map("planned_start_at")
  estimatedMinutes        Int?      @map("estimated_minutes")
  progressPercent         Int?      @map("progress_percent")
  startedAt               DateTime? @map("started_at")
  completedAt             DateTime? @map("completed_at")
  blockedReason           String?   @map("blocked_reason")
  createdByUserId         String    @map("created_by_user_id") @db.Uuid
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  project            Project           @relation(fields: [projectId], references: [id])
  issue              Issue?            @relation(fields: [issueId], references: [id])
  milestone          Milestone?        @relation(fields: [milestoneId], references: [id])
  phase              Phase?            @relation(fields: [phaseId], references: [id])
  deliverable        Deliverable?      @relation(fields: [deliverableId], references: [id])
  workPackage        WorkPackage?      @relation(fields: [workPackageId], references: [id])
  predecessorOf      TaskDependency[]  @relation("TaskAsPredecessor")
  successorOf        TaskDependency[]  @relation("TaskAsSuccessor")

  @@index([organizationId, projectId])
  @@index([issueId])
  @@index([milestoneId])
  @@index([phaseId])
  @@index([deliverableId])
  @@index([workPackageId])
  @@map("tasks")
  @@schema("planning")
}

/// Finish-to-start only. Unique pair. Same Project. Cycle rejection is application-level.
model TaskDependency {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  predecessorTaskId String   @map("predecessor_task_id") @db.Uuid
  successorTaskId   String   @map("successor_task_id") @db.Uuid
  type              String   @default("FINISH_TO_START")
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  predecessor Task @relation("TaskAsPredecessor", fields: [predecessorTaskId], references: [id])
  successor   Task @relation("TaskAsSuccessor", fields: [successorTaskId], references: [id])

  @@unique([predecessorTaskId, successorTaskId])
  @@index([organizationId, projectId])
  @@index([successorTaskId])
  @@map("task_dependencies")
  @@schema("planning")
}

/// Project checkpoint. ACHIEVED is explicit. AT_RISK / MISSED are derived on read.
model Milestone {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  title            String
  description      String    @default("")
  /// Stored explicit state only: PLANNED | ACHIEVED | CANCELLED.
  status           String    @default("PLANNED")
  targetDate       DateTime? @map("target_date")
  phaseId          String?   @map("phase_id") @db.Uuid
  deliverableId    String?   @map("deliverable_id") @db.Uuid
  achievedByUserId String?   @map("achieved_by_user_id") @db.Uuid
  achievedAt       DateTime? @map("achieved_at")
  cancelledByUserId String?  @map("cancelled_by_user_id") @db.Uuid
  cancelledAt      DateTime? @map("cancelled_at")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id])
  phase       Phase?       @relation(fields: [phaseId], references: [id])
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  tasks       Task[]

  @@index([organizationId, projectId])
  @@index([phaseId])
  @@index([deliverableId])
  @@map("milestones")
  @@schema("planning")
}

// ---------------------------------------------------------------------------
// governance — Gate / Requirement / Formal Exception / durable release (PF-1.6 / 0.5)
// Formal Exception is the sole bypass. Exception never marks a requirement SATISFIED.
// READY ≠ RELEASED. RELEASED ≠ RELEASED_WITH_EXCEPTION. No gate.override.
// ---------------------------------------------------------------------------

/// Governance checkpoint. Created NOT_READY. Evaluation never auto-releases.
model Gate {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  projectId            String    @map("project_id") @db.Uuid
  name                 String
  description          String    @default("")
  /// NOT_READY | BLOCKED | READY | RELEASED | RELEASED_WITH_EXCEPTION
  status               String    @default("NOT_READY")
  lastEvaluatedAt      DateTime? @map("last_evaluated_at")
  lastEvaluatedByUserId String?  @map("last_evaluated_by_user_id") @db.Uuid
  releasedAt           DateTime? @map("released_at")
  releasedByUserId     String?   @map("released_by_user_id") @db.Uuid
  releaseKind          String?   @map("release_kind")
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  project      Project              @relation(fields: [projectId], references: [id])
  requirements GateRequirement[]
  exceptions   FormalException[]
  releases     GateReleaseDecision[]

  @@index([organizationId, projectId])
  @@map("gates")
  @@schema("governance")
}

/// Typed mandatory/optional predicate. Satisfaction is independent of Exception coverage.
model GateRequirement {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  gateId                  String    @map("gate_id") @db.Uuid
  type                    String
  title                   String
  mandatory               Boolean   @default(true)
  config                  Json
  /// Requirement-scoped checklist (CHECKLIST_COMPLETE). Not a Coordination Checklist module.
  checklist               Json
  lastSatisfaction        String?   @map("last_satisfaction")
  lastCoveredByException  Boolean   @default(false) @map("last_covered_by_exception")
  lastCoveringExceptionId String?   @map("last_covering_exception_id") @db.Uuid
  lastEvaluatedAt         DateTime? @map("last_evaluated_at")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  project    Project           @relation(fields: [projectId], references: [id])
  gate       Gate              @relation(fields: [gateId], references: [id])
  exceptions FormalException[]
  usedInReleases GateReleaseUsedException[]

  @@index([organizationId, projectId])
  @@index([gateId])
  @@map("gate_requirements")
  @@schema("governance")
}

/// Requirement-specific Formal Exception. History is append-forward only.
model FormalException {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  gateId             String    @map("gate_id") @db.Uuid
  gateRequirementId  String    @map("gate_requirement_id") @db.Uuid
  /// REQUESTED | APPROVED | REJECTED | REVOKED
  status             String    @default("REQUESTED")
  reason             String
  requestedByUserId  String    @map("requested_by_user_id") @db.Uuid
  requestedAt        DateTime  @default(now()) @map("requested_at")
  decidedByUserId    String?   @map("decided_by_user_id") @db.Uuid
  decidedAt          DateTime? @map("decided_at")
  revokedByUserId    String?   @map("revoked_by_user_id") @db.Uuid
  revokedAt          DateTime? @map("revoked_at")
  expiresAt          DateTime? @map("expires_at")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project            Project                    @relation(fields: [projectId], references: [id])
  gate               Gate                       @relation(fields: [gateId], references: [id])
  requirement        GateRequirement            @relation(fields: [gateRequirementId], references: [id])
  usedInReleases     GateReleaseUsedException[]

  @@index([organizationId, projectId])
  @@index([gateRequirementId])
  @@map("formal_exceptions")
  @@schema("governance")
}

/// Immutable release evidence. A later revoke never rewrites this row.
model GateReleaseDecision {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  gateId              String   @map("gate_id") @db.Uuid
  /// NORMAL | WITH_EXCEPTION
  kind                String
  releasedByUserId    String   @map("released_by_user_id") @db.Uuid
  releasedAt          DateTime @default(now()) @map("released_at")
  gateVersion         Int      @map("gate_version")
  evaluationSnapshot  Json     @map("evaluation_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")

  project       Project                    @relation(fields: [projectId], references: [id])
  gate          Gate                       @relation(fields: [gateId], references: [id])
  usedExceptions GateReleaseUsedException[]

  @@index([organizationId, projectId])
  @@index([gateId, releasedAt])
  @@map("gate_release_decisions")
  @@schema("governance")
}

model GateReleaseUsedException {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String @map("organization_id") @db.Uuid
  projectId          String @map("project_id") @db.Uuid
  releaseDecisionId  String @map("release_decision_id") @db.Uuid
  formalExceptionId  String @map("formal_exception_id") @db.Uuid
  gateRequirementId  String @map("gate_requirement_id") @db.Uuid

  project           Project            @relation(fields: [projectId], references: [id])
  releaseDecision   GateReleaseDecision @relation(fields: [releaseDecisionId], references: [id])
  formalException   FormalException    @relation(fields: [formalExceptionId], references: [id])
  requirement       GateRequirement    @relation(fields: [gateRequirementId], references: [id])

  @@unique([releaseDecisionId, formalExceptionId])
  @@index([formalExceptionId])
  @@map("gate_release_used_exceptions")
  @@schema("governance")
}

// ---------------------------------------------------------------------------
// calendar — user-owned private calendars, explicit grants, events (M5.1)
// Calendar access never grants Project access. Referenced sources stay owned
// by Planning / Operations / Governance. Archive never cascade-deletes sources.
// ---------------------------------------------------------------------------

/// Organization-bound, exactly one owner, private by default, unlimited per user.
model Calendar {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId               String    @map("organization_id") @db.Uuid
  ownerOrganizationMembershipId String   @map("owner_organization_membership_id") @db.Uuid
  name                         String
  description                  String    @default("")
  timeZone                     String    @map("time_zone")
  /// ACTIVE | ARCHIVED
  status                       String    @default("ACTIVE")
  archivedAt                   DateTime? @map("archived_at")
  version                      Int       @default(1)
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id])
  owner        OrganizationMembership @relation(fields: [ownerOrganizationMembershipId], references: [id])
  grants       CalendarAccessGrant[]
  events       CalendarEvent[]

  @@unique([id, organizationId])
  @@index([organizationId, ownerOrganizationMembershipId])
  @@map("calendars")
  @@schema("calendar")
}

/// Explicit USER or TEAM grant. Owner is not a grant row. Revoke one path ≠ revoke all.
model CalendarAccessGrant {
  id                                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                    String    @map("organization_id") @db.Uuid
  calendarId                        String    @map("calendar_id") @db.Uuid
  /// USER | TEAM
  principalKind                     String    @map("principal_kind")
  organizationMembershipId          String?   @map("organization_membership_id") @db.Uuid
  teamId                            String?   @map("team_id") @db.Uuid
  /// VIEWER | EDITOR
  role                              String
  revokedAt                         DateTime? @map("revoked_at")
  createdByOrganizationMembershipId String    @map("created_by_organization_membership_id") @db.Uuid
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  calendar    Calendar               @relation(fields: [calendarId], references: [id])
  subjectUser OrganizationMembership? @relation("CalendarGrantSubject", fields: [organizationMembershipId], references: [id])
  subjectTeam Team?                  @relation(fields: [teamId], references: [id])
  createdBy   OrganizationMembership @relation("CalendarGrantCreator", fields: [createdByOrganizationMembershipId], references: [id])

  @@index([calendarId])
  @@index([organizationMembershipId])
  @@index([teamId])
  @@map("calendar_access_grants")
  @@schema("calendar")
}

/// MANUAL or REFERENCED. Referenced title/date/status are not source of truth.
model CalendarEvent {
  id                                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                    String    @map("organization_id") @db.Uuid
  calendarId                        String    @map("calendar_id") @db.Uuid
  /// MANUAL | REFERENCED
  kind                              String
  title                             String
  description                       String    @default("")
  allDay                            Boolean   @default(false) @map("all_day")
  startsAt                          DateTime? @map("starts_at")
  endsAt                            DateTime? @map("ends_at")
  timeZone                          String?   @map("time_zone")
  allDayStartDate                   DateTime? @map("all_day_start_date") @db.Date
  allDayEndDate                     DateTime? @map("all_day_end_date") @db.Date
  linkedProjectId                   String?   @map("linked_project_id") @db.Uuid
  /// TASK | MILESTONE | DELIVERABLE | GATE
  referenceType                     String?   @map("reference_type")
  referenceId                       String?   @map("reference_id") @db.Uuid
  createdByOrganizationMembershipId String    @map("created_by_organization_membership_id") @db.Uuid
  version                           Int       @default(1)
  archivedAt                        DateTime? @map("archived_at")
  createdAt                         DateTime  @default(now()) @map("created_at")
  updatedAt                         DateTime  @updatedAt @map("updated_at")

  calendar  Calendar               @relation(fields: [calendarId], references: [id])
  createdBy OrganizationMembership @relation(fields: [createdByOrganizationMembershipId], references: [id])

  @@index([calendarId, startsAt])
  @@index([calendarId, allDayStartDate])
  @@index([organizationId, referenceType, referenceId])
  @@map("calendar_events")
  @@schema("calendar")
}

// ---------------------------------------------------------------------------
// messaging — DIRECT / TEAM conversations, messages, per-user read-state (M5.1)
// Chat is collaboration, not system of record. Participation ≠ Project access.
// ---------------------------------------------------------------------------

/// Organization-scoped DIRECT (unordered membership pair) or TEAM (one per Team).
model Conversation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  /// DIRECT | TEAM
  kind             String
  teamId           String?  @unique @map("team_id") @db.Uuid
  participantLowId String?  @map("participant_low_id") @db.Uuid
  participantHighId String? @map("participant_high_id") @db.Uuid
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization    Organization            @relation(fields: [organizationId], references: [id])
  team            Team?                   @relation(fields: [teamId], references: [id])
  participantLow  OrganizationMembership? @relation("DirectParticipantLow", fields: [participantLowId], references: [id])
  participantHigh OrganizationMembership? @relation("DirectParticipantHigh", fields: [participantHighId], references: [id])
  messages        Message[]
  readStates      MessageReadState[]

  @@unique([id, organizationId])
  @@index([organizationId, kind])
  @@map("conversations")
  @@schema("messaging")
}

/// Append-forward message. Edit sets editedAt. Delete is a tombstone (deletedAt).
model Message {
  id                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId                 String    @map("organization_id") @db.Uuid
  conversationId                 String    @map("conversation_id") @db.Uuid
  authorOrganizationMembershipId String    @map("author_organization_membership_id") @db.Uuid
  body                           String
  editedAt                       DateTime? @map("edited_at")
  deletedAt                      DateTime? @map("deleted_at")
  version                        Int       @default(1)
  createdAt                      DateTime  @default(now()) @map("created_at")

  conversation Conversation           @relation(fields: [conversationId], references: [id])
  author       OrganizationMembership @relation(fields: [authorOrganizationMembershipId], references: [id])
  readStates   MessageReadState[]

  @@index([conversationId, createdAt, id])
  @@index([organizationId])
  @@map("messages")
  @@schema("messaging")
}

/// Per-user watermark. Unread = others' messages after (lastReadCreatedAt, lastReadMessageId).
model MessageReadState {
  conversationId           String    @map("conversation_id") @db.Uuid
  organizationMembershipId String    @map("organization_membership_id") @db.Uuid
  lastReadMessageId        String?   @map("last_read_message_id") @db.Uuid
  lastReadCreatedAt        DateTime? @map("last_read_created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  conversation Conversation           @relation(fields: [conversationId], references: [id])
  membership   OrganizationMembership @relation(fields: [organizationMembershipId], references: [id])
  lastRead     Message?               @relation(fields: [lastReadMessageId], references: [id])

  @@id([conversationId, organizationMembershipId])
  @@index([organizationMembershipId])
  @@map("message_read_states")
  @@schema("messaging")
}

// ---------------------------------------------------------------------------
// audit — INSERT (+SELECT) for app role; NO UPDATE/DELETE (F-09)
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  eventType      String   @map("event_type")
  resourceType   String   @map("resource_type")
  resourceId     String?  @map("resource_id")
  correlationId  String   @map("correlation_id")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_events")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// jobs — outbox, idempotency, dead letter (foundation primitives)
// ---------------------------------------------------------------------------

model OutboxMessage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([processedAt, createdAt])
  @@map("outbox_messages")
  @@schema("jobs")
}

model IdempotencyRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, key])
  @@map("idempotency_records")
  @@schema("jobs")
}

model DeadLetter {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobName        String   @map("job_name")
  idempotencyKey String   @map("idempotency_key")
  payload        Json
  error          String
  attempts       Int
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("dead_letters")
  @@schema("jobs")
}

model JobIdempotency {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobKey    String   @unique @map("job_key")
  result    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_idempotency")
  @@schema("jobs")
}
