# Amber Modular Monolith — local/dev template. No production secrets.
# Copy to .env and adjust. See docs/development/local-setup.md
# and docs/development/m3.8-local-rc-runbook.md (Bruno bootstrap).
#
# LOCAL ONLY. Never put live cloud tokens here or in git.

NODE_ENV=development
LOG_LEVEL=info

# Bind HTTP servers to 0.0.0.0:$PORT (Render / PaaS / local compose).
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# Build identity (health/readiness). Leave as "dev" locally; CI sets GIT_SHA.
GIT_SHA=dev
BUILD_ID=local

# PostgreSQL (system of record). Superuser/migrator URL.
# Compose service name: postgres  host port: 5432
DATABASE_URL=postgresql://amber:amber@localhost:5432/amber

# Application role: INSERT+SELECT on audit, no UPDATE/DELETE (F-09).
# Created by the initial migration (local password is a documented placeholder).
APP_DATABASE_URL=postgresql://amber_app:amber_app_dev@localhost:5432/amber

# Redis is optional until the first justified async job ships (0.6).
# Leave empty to keep the worker in scaffold/no-op mode. Local RC default: OFF.
REDIS_URL=

# S3-compatible object storage (MinIO locally).
# Compose service name: minio  API: 9000  console: 9001
# Current files adapter still uses OBJECT_STORAGE_DIR (local disk).
# MinIO is provisioned so the S3 contract is present for later wiring.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=amberminio
S3_SECRET_KEY=amberminio
S3_BUCKET=amber-files
S3_FORCE_PATH_STYLE=true
OBJECT_STORAGE_DIR=./.data/objects
FILE_SIGNING_SECRET=dev-only-file-signing

# Session cookie (HttpOnly, Secure, SameSite). Token hash stored server-side (0.2A).
SESSION_COOKIE_NAME=amber_session
SESSION_COOKIE_SECURE=false
# Inactivity 12h / absolute 7d floors from 0.2A — do not weaken.
SESSION_INACTIVE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
# Dev-only key material. Never commit production secrets.
SESSION_SECRET=dev-only-session-secret
MFA_ENCRYPTION_KEY=dev-only-mfa-key-not-for-prod
WEB_ORIGIN=http://localhost:3000

# OpenTelemetry hooks. Empty exporter = SDK registered, no remote export.
OTEL_SERVICE_NAME=amber-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Public API URL for web. Browser uses same-origin /api rewrite.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://127.0.0.1:3001

# Correlation
CORRELATION_HEADER=x-correlation-id

# M3 synthetic seed is opt-in. Local RC bootstrap sets this to 1.
# Password for seed users lives in packages/shared (M3_SEED_PASSWORD) —
# well-known local synthetic, not a production secret. Do not paste live passwords.
AMBER_SEED_M3=0
