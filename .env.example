# Amber Modular Monolith — local/dev template. No production secrets.
# Copy to .env and adjust. See docs/development/local-setup.md

NODE_ENV=development
LOG_LEVEL=info

# Bind HTTP servers to 0.0.0.0:$PORT (Render / PaaS).
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# PostgreSQL (system of record). Superuser/migrator URL.
DATABASE_URL=postgresql://amber:amber@localhost:5432/amber

# Application role: INSERT+SELECT on audit, no UPDATE/DELETE (F-09).
APP_DATABASE_URL=postgresql://amber_app:amber_app_dev@localhost:5432/amber

# Redis is optional until the first justified async job ships (0.6).
# Leave empty to keep the worker in scaffold/no-op mode.
REDIS_URL=

# S3-compatible object storage (MinIO locally). Vendor for malware scan remains OPEN.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=amberminio
S3_SECRET_KEY=amberminio
S3_BUCKET=amber-files
S3_FORCE_PATH_STYLE=true

# Session cookie (HttpOnly, Secure, SameSite). Token hash stored server-side (0.2A).
SESSION_COOKIE_NAME=amber_session
SESSION_COOKIE_SECURE=false
# Inactivity 12h / absolute 7d floors from 0.2A — do not weaken.
SESSION_INACTIVE_HOURS=12
SESSION_ABSOLUTE_DAYS=7

# OpenTelemetry hooks. Empty exporter = SDK registered, no remote export.
OTEL_SERVICE_NAME=amber-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Public API URL for web.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Correlation
CORRELATION_HEADER=x-correlation-id
